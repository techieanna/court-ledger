# ============================================================
# LOCAL DEV (zero-setup) — just copy this file to .env.local
# ============================================================
# Data stored in ./data/*.json, login is a simple email form.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me

# Data backend: "file" (JSON files) or "sheets" (Google Sheets)
DATA_BACKEND=file

# Auth mode: "dev" (Credentials form) or unset (Google OAuth)
AUTH_MODE=dev
NEXT_PUBLIC_AUTH_MODE=dev

# Admin email — must match what you type at the dev login form
ADMIN_EMAIL=admin@example.com


# ============================================================
# PRODUCTION (Vercel) — switch backends + add real credentials
# ============================================================
# DATA_BACKEND=sheets
# AUTH_MODE=
# NEXT_PUBLIC_AUTH_MODE=

# Google OAuth (for admin login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google Sheets data layer
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=svc@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
